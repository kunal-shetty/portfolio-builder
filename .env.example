# Groq key for the AI features (server-side only; never prefix with NEXT_PUBLIC_).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: any Groq chat model id (default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Rate limits (0 disables one). Per visitor IP unless noted.
# AI_RATE_LIMIT_PER_MINUTE=8
# AI_RATE_LIMIT_PER_DAY=100
# Cap across all visitors combined:
# AI_GLOBAL_RATE_LIMIT_PER_MINUTE=60

# Strongly recommended on serverless (Vercel/Netlify): share rate-limit counts across
# instances with a free Upstash Redis database. Without these, limits are per instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
